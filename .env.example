# Copy to .env and fill in. NEVER commit .env.

# Hindsight — base URL and API key from your Hindsight Cloud dashboard
# (https://ui.hindsight.vectorize.io). For a local Docker server: http://localhost:8888
HINDSIGHT_BASE_URL=
HINDSIGHT_API_KEY=
# Your personal test prefix: dev-shreyan / dev-samprada / dev-niya
# Only the final demo load uses: demo
HINDSIGHT_BANK_PREFIX=dev-yourname

# Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# 1 = AI functions return sample data (for UI work without keys)
ONKO_STUBS=0
